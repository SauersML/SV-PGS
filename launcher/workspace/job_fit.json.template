{
  "taskGroups": [
    {
      "taskCount": 1,
      "taskSpec": {
        "runnables": [{"script": {"text": "bash /mnt/disks/ops/svpgs/${RUN_ID}/launcher/run_step.sh"}}],
        "maxRetryCount": ${MAX_RETRIES},
        "maxRunDuration": "${MAX_RUN_SECONDS}s",
        "lifecyclePolicies": [
          {"action": "FAIL_TASK", "actionCondition": {"exitCodes": [1]}}
        ],
        "volumes": [
          {"gcs": {"remotePath": "${OPS_BUCKET}"}, "mountPath": "/mnt/disks/ops", "mountOptions": ["--implicit-dirs"]},
          {"gcs": {"remotePath": "${CDR_BUCKET}"}, "mountPath": "/mnt/disks/cdr", "mountOptions": ["-o ro", "--implicit-dirs", "--billing-project=${GOOGLE_PROJECT}"]},
          {"gcs": {"remotePath": "${IMPUTED_BUCKET}"}, "mountPath": "/mnt/disks/imputed", "mountOptions": ["-o ro", "--implicit-dirs"]},
          {"gcs": {"remotePath": "${PANEL_BUCKET}"}, "mountPath": "/mnt/disks/panel", "mountOptions": ["-o ro", "--implicit-dirs"]},
          {"deviceName": "run", "mountPath": "/mnt/disks/run", "mountOptions": "rw,async"}
        ]
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "installGpuDrivers": true,
        "policy": {
          "machineType": "${MACHINE_TYPE}",
          "provisioningModel": "${PROVISIONING_MODEL}",
          "accelerators": [{"type": "${GPU_TYPE}", "count": ${GPU_COUNT}}],
          "disks": [{"deviceName": "run", "newDisk": {"type": "pd-balanced", "sizeGb": ${RUN_DISK_GB}}}]
        }
      }
    ],
    "location": {"allowedLocations": ["zones/${ZONE}"]},
    "network": {
      "networkInterfaces": [
        {
          "network": "projects/${PROJECT_ID}/global/networks/${NETWORK}",
          "subnetwork": "projects/${PROJECT_ID}/regions/${REGION}/subnetworks/${SUBNETWORK}",
          "noExternalIpAddress": true
        }
      ]
    },
    "serviceAccount": {"email": "${SERVICE_ACCOUNT}"}
  },
  "logsPolicy": {"destination": "PATH", "logsPath": "/mnt/disks/ops/svpgs/${RUN_ID}/launcher/batch.log"}
}
