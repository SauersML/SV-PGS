#!/bin/bash
# TEMPLATE, never launched by an agent: launching is the user's decision (submit.sh fills and submits it).
# The Batch task. It builds the locked environment offline with uv from what the user staged under
# svpgs/${RUN_ID}/ in the ops bucket (the source tree, and env.tar: the uv binary, a uv cache holding every
# locked wheel, and a uv-installed CPython 3.12), then runs the pipeline through ${THROUGH}. The VM has no external IP,
# and the image's own Python is not the 3.12 sv-pgs needs, so nothing is fetched and the image's Python is never used.
# Status goes only to empty marker files in the workspace's ops bucket mount.
set -uo pipefail
OPS=/mnt/disks/ops/svpgs/${RUN_ID}
RUN=/mnt/disks/run
# A store job of ${TASK_COUNT} tasks is a fan-out over the run config's chromosomes: Batch's task i converts chromosome i
# on its own VM and disk (the driver's --store-shard), or the i-th of STORE_SHARDS' chromosome indices where it names
# them ("${STORE_SHARDS}"), the mirror carries each task's chromosomes to the next job, and each task's markers carry
# its chromosome index.
shard=()
tag=""
shards=(${STORE_SHARDS})
if [ "${TASK_COUNT}" != 1 ] || [ "${#shards[@]}" != 0 ]; then
  index="${shards[$BATCH_TASK_INDEX]:-$BATCH_TASK_INDEX}"
  shard=(--store-shard "$index"); tag="${index}-"
fi
# A fit job given FIT_ARMS ("${FIT_ARMS}") fits only those arms (the driver's --fit-arm), so each arm can have its own VM;
# the mirror carries each job's models to the job that finds every arm fitted.
fit_arm=()
for arm in ${FIT_ARMS}; do fit_arm+=(--fit-arm "$arm"); done
mark() { mkdir -p "$OPS/markers" && : > "$OPS/markers/$(date -u +%Y%m%dT%H%M%SZ)_task_${tag}$1"; }
trap 'mark "terminated"; exit 75' TERM
mark started
if [ ! -f "$RUN/tools/staged" ]; then
  # uv, Python and the cache come as one tarball read in one stream: copied file by file over the bucket mount, the
  # cache's tens of thousands of files took over 20 minutes. The marker is written last, so an extraction a preemption
  # cut short is redone.
  rm -rf "$RUN/tools" "$RUN/bin" "$RUN/python" "$RUN/uv-cache" && mkdir -p "$RUN/tools" && tar -xf "$OPS/env.tar" -C "$RUN" \
    && mv "$RUN/bin/uv" "$RUN/tools/uv" && chmod +x "$RUN/tools/uv" "$RUN"/python/*/bin/* && : > "$RUN/tools/staged" \
    || { mark "exit-install"; exit 1; }
fi
# Every start syncs: a retried task can find the venv a preempted attempt left half built, and the sync adds only what
# this job's extras (the GPU job's --extra gpu: CuPy and the CUDA wheels) need. It builds from this task's own copy of
# the staged source: the editable build writes sv_pgs.egg-info into the project, and 22 fan-out tasks writing it on the
# shared bucket mount failed with "Stale file handle".
rm -rf "$RUN/source" && cp -r "$OPS/source" "$RUN/source" || { mark "exit-install"; exit 1; }
UV_OFFLINE=1 UV_CACHE_DIR="$RUN/uv-cache" UV_PYTHON_INSTALL_DIR="$RUN/python" UV_PROJECT_ENVIRONMENT="$RUN/venv" UV_LINK_MODE=copy \
  "$RUN/tools/uv" sync --project "$RUN/source" --frozen --no-dev --python 3.12 ${UV_EXTRAS} \
  || { mark "exit-install"; exit 1; }
case "${UV_EXTRAS}" in
  # The CUDA libraries come from the gpu extra's nvidia-* wheels, which CuPy does not search: on the Batch image, which
  # has the driver and no toolkit, the first kernel it compiled failed with "CuPy failed to load libnvrtc.so.12".
  # A fit job that cannot reach its GPU would fit on the CPUs at the GPU VM's price until its timeout: it stops here,
  # and also if CuPy cannot compile and run a kernel.
  *gpu*) export LD_LIBRARY_PATH="$(ls -d "$RUN"/venv/lib/python3.12/site-packages/nvidia/*/lib | paste -sd:)${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
         "$RUN/venv/bin/python" -c "import cupy, sys; sys.exit(cupy.cuda.runtime.getDeviceCount() < 1 or float(cupy.eye(2).sum()) != 2.0)" \
           || { mark "exit-no-gpu"; exit 1; } ;;
esac
export WORKSPACE_CDR="${WORKSPACE_CDR}" GOOGLE_PROJECT="${GOOGLE_PROJECT}" TMPDIR="$RUN/tmp"
# google-auth 2.4x reaches the metadata server over mTLS when the VM offers its certificates, and the Batch image's
# do not verify ("CERTIFICATE_VERIFY_FAILED"): the job then had no credentials. Plain HTTP to the metadata server is
# the VM-local path every earlier version used.
export GCE_METADATA_MTLS_MODE=none
# numpy's OpenBLAS is built for 128 threads and keeps a buffer table of that size: each of its own workers holds one,
# and each thread calling it takes one more. The stage-0 host pool calls it from one thread per CPU. On 128 vCPUs the
# table overflowed ("precompiled NUM_THREADS exceeded, adding auxiliary array for thread metadata") with 127 workers
# and again with 63, and the fit died 20 s in (segfault, or "corrupted double-linked list"); on 64 vCPUs with 63 it
# ran. Its workers get the room the pool leaves, at most one per CPU: a fit VM above 64 vCPUs has almost none.
cpus=$(nproc)
room=$(( 128 - cpus ))
export OPENBLAS_NUM_THREADS=$(( room < 1 ? 1 : room < cpus ? room : cpus ))
# A driver that dies on a signal writes every thread's Python stack to the task log: the first AoU fits ended in
# "Segmentation fault" with no other line.
export PYTHONFAULTHANDLER=1
# Two minutes without a progress line, the driver logs where its main thread is (sv_pgs/progress.py), so the progress
# copy below shows what a silent stretch spends its time on: the AoU disease fits went twenty minutes between lines.
export SVPGS_QUIET_STACK_SECONDS=120
# The job's bucket mounts (the job templates' volumes): an input file there is keyed by its object's generation instead
# of a pass over its bytes (sv_pgs/content_identity.py), which for the imputed and GATK-SV call sets is terabytes a start.
# IMPUTED_BUCKET holds the imputed batches and their strata sidecar, PANEL_BUCKET the panel's bubble.split sites.
export SVPGS_GCS_MOUNTS='{"/mnt/disks/ops": "gs://${OPS_BUCKET}", "/mnt/disks/cdr": "gs://${CDR_BUCKET}", "/mnt/disks/imputed": "gs://${IMPUTED_BUCKET}", "/mnt/disks/panel": "gs://${PANEL_BUCKET}"}'
mkdir -p "$TMPDIR"
# Batch cannot write to an existing disk, so this job's disk is new and the run lives in the workspace bucket
# (sv_pgs/run_mirror.py): restored before the driver starts, pushed every 15 minutes while it runs (each push sends
# only new checkpoints and finished steps), and pushed once more after it exits. A preemption loses at most the fit
# progress since the last push. flock keeps one push at a time.
mirror() {
  flock "$RUN/mirror.lock" "$RUN/venv/bin/sv-pgs" run-mirror "$1" --config "$OPS/run_config.json" --mirror "gs://${OPS_BUCKET}/svpgs/${RUN_ID}/run"
}
mirror restore || { mark "exit-restore"; exit 1; }
# A loop's sleep goes first: killed alone, the subshell left it running, and the task (and its log) ended only when the
# sleep did, up to 15 minutes later. A push in progress is left to finish; the last push below waits on its lock.
stop() { pkill -x -P "$1" sleep 2>/dev/null; kill "$1" 2>/dev/null; }
( while sleep 900; do mirror push || mark "push-failed"; done ) &
pusher=$!
# Batch writes the task log to the bucket only when the task ends, so a fit gave no sign of its progress for hours. The
# driver's stderr also goes to a file whose last lines are copied beside the task log every 5 minutes: the same lines
# the task log holds (steps, counts, timings, paths).
progress="$(dirname "$0")/progress-task${BATCH_TASK_INDEX}.log"
"$RUN/venv/bin/sv-pgs" workspace-run --config "$OPS/run_config.json" --through "${THROUGH}" ${shard[@]+"${shard[@]}"} ${fit_arm[@]+"${fit_arm[@]}"} \
  2> >(tee "$RUN/driver.log" >&2) &
driver=$!
( while sleep 300; do tail -n 300 "$RUN/driver.log" > "$progress" 2>/dev/null; done ) &
progressor=$!
wait "$driver"
status=$?
stop "$progressor"
tail -n 300 "$RUN/driver.log" > "$progress" 2>/dev/null
# AFTER_SCRIPT ("${AFTER_SCRIPT}"), a script of the source tree, runs once the driver has finished, with RUN and OPS set,
# its output beside the progress log: benchmarks/bench_real/aou_ldpred2.sh reads the steps the driver left.
if [ "$status" -eq 0 ] && [ -n "${AFTER_SCRIPT}" ]; then
  mark "after-started"
  RUN="$RUN" OPS="$OPS" bash "$RUN/source/${AFTER_SCRIPT}" > "$(dirname "$0")/after-task${BATCH_TASK_INDEX}.log" 2>&1 \
    && mark "after-done" || { mark "exit-after"; status=1; }
fi
stop "$pusher"
# A run whose last push failed did not keep its results: the job fails even if the driver finished.
mirror push || { mark "exit-push"; [ "$status" -ne 0 ] || status=1; }
mark "exit-${status}"
exit "$status"
