#!/bin/bash
# TEMPLATE, never launched by an agent: launching is the user's decision (submit.sh fills and submits it).
# The Batch task. It builds the locked environment offline with uv from what the user staged under
# svpgs/${RUN_ID}/ in the ops bucket, or under the round's one staging (STAGED_SOURCE, below) (the source tree, and
# env.tar: the uv binary, a uv cache holding every locked wheel, and a uv-installed CPython 3.12), then runs the
# pipeline through ${THROUGH}. The VM has no external IP,
# and the image's own Python is not the 3.12 sv-pgs needs, so nothing is fetched and the image's Python is never used.
# Status goes only to empty marker files in the workspace's ops bucket mount.
set -uo pipefail
OPS=/mnt/disks/ops/svpgs/${RUN_ID}
RUN=/mnt/disks/run
# STAGED_SOURCE ("${STAGED_SOURCE}"), when set, is the directory under svpgs/ in the ops bucket whose source/ and env.tar
# this job builds from: one staging every run of a round shares (launcher/workspace/round.py), where each run had its
# own, copied to it one run at a time. Empty, it is the run's own, svpgs/${RUN_ID}. The run's config, markers, launcher
# and mirror stay the run's own either way.
staged_source="${STAGED_SOURCE}"
STAGED="$OPS"
[ -z "$staged_source" ] || STAGED="$(dirname "$OPS")/$staged_source"
# A store job of ${TASK_COUNT} tasks is a fan-out over the run config's chromosomes: Batch's task i converts chromosome i
# on its own VM and disk (the driver's --store-shard), or the i-th of STORE_SHARDS' chromosome indices where it names
# them ("${STORE_SHARDS}"), the mirror carries each task's chromosomes to the next job, and each task's markers carry
# its chromosome index.
shard=()
tag=""
shards=(${STORE_SHARDS})
if [ "${TASK_COUNT}" != 1 ] || [ "${#shards[@]}" != 0 ]; then
  index="${shards[$BATCH_TASK_INDEX]:-$BATCH_TASK_INDEX}"
  shard=(--store-shard "$index"); tag="${index}-"
fi
# A fit job given FIT_ARMS ("${FIT_ARMS}") fits only those arms (the driver's --fit-arm), so each arm can have its own VM;
# the mirror carries each job's models to the job that finds every arm fitted.
fit_arm=()
for arm in ${FIT_ARMS}; do fit_arm+=(--fit-arm "$arm"); done
mark() { mkdir -p "$OPS/markers" && : > "$OPS/markers/$(date -u +%Y%m%dT%H%M%SZ)_task_${tag}$1"; }
trap 'mark "terminated"; exit 75' TERM
mark started
# The environment runs from this task's own copy of the staged source: the editable build writes sv_pgs.egg-info into
# the project, and 22 fan-out tasks writing it on the shared bucket mount failed with "Stale file handle".
rm -rf "$RUN/source" && cp -r "$STAGED/source" "$RUN/source" || { mark "exit-install"; exit 1; }
# A staging that lists its files' digests (source.sha256, sha256sum's form, which round.py writes) is checked against
# this task's copy before anything runs from it: a copy of the tree that was cut short, or a file changed since, stops
# the job here instead of running other code than the round staged.
if [ -f "$STAGED/source.sha256" ]; then
  (cd "$RUN/source" && sha256sum --quiet --strict -c "$STAGED/source.sha256") || { mark "exit-source"; exit 1; }
fi
# SHARED_RUNTIME ("${SHARED_RUNTIME}"), when 1: a job takes its environment ($RUN/venv and $RUN/python) prebuilt from
# the ops bucket's svpgs/_runtime/<key>/<publisher>/ if a job has published one there for this uv.lock, pyproject.toml
# and extras (key), instead of extracting env.tar and syncing; and a job that built its own publishes it there once its
# GPU check passed. Its parts (runtime_pack.py) are read and extracted at once, where env.tar is one stream. One
# environment serves every run of that lock: the code it runs is still each run's own source, which the editable
# install names. The CPython in it is the one the publishing job's env.tar carried.
unpack() {
  local parts part pids=() failed=0
  read -r parts < "$1/COMPLETE" && [ "$(ls "$1"/part-*.tar | wc -l)" = "$parts" ] || return 1
  for part in "$1"/part-*.tar; do tar -xf "$part" -C "$RUN" & pids+=($!); done
  for part in ${pids[@]+"${pids[@]}"}; do wait "$part" || failed=1; done
  return "$failed"
}
runtime=""
prebuilt=""
if [ "${SHARED_RUNTIME}" = 1 ]; then
  key=$( { cat "$RUN/source/uv.lock" "$RUN/source/pyproject.toml"; echo "${UV_EXTRAS}"; } | sha256sum | cut -c1-16)
  runtime="$(dirname "$OPS")/_runtime/$key"
  if [ ! -f "$RUN/tools/runtime-$key" ]; then
    for published in "$runtime"/*/COMPLETE; do
      [ -f "$published" ] || continue
      # The marker is written last, so an extraction a preemption cut short is redone.
      rm -rf "$RUN/venv" "$RUN/python" && mkdir -p "$RUN/tools" && unpack "$(dirname "$published")" \
        && : > "$RUN/tools/runtime-$key" && break
    done
  fi
  [ ! -f "$RUN/tools/runtime-$key" ] || prebuilt=1
fi
if [ -z "$prebuilt" ]; then
  if [ ! -f "$RUN/tools/staged" ]; then
    # uv, Python and the cache come as one tarball read in one stream: copied file by file over the bucket mount, the
    # cache's tens of thousands of files took over 20 minutes. The marker is written last, so an extraction a
    # preemption cut short is redone.
    rm -rf "$RUN/tools" "$RUN/bin" "$RUN/python" "$RUN/uv-cache" && mkdir -p "$RUN/tools" && tar -xf "$STAGED/env.tar" -C "$RUN" \
      && mv "$RUN/bin/uv" "$RUN/tools/uv" && chmod +x "$RUN/tools/uv" "$RUN"/python/*/bin/* && : > "$RUN/tools/staged" \
      || { mark "exit-install"; exit 1; }
  fi
  # Every start that builds syncs: a retried task can find the venv a preempted attempt left half built, and the sync
  # adds only what this job's extras (the GPU job's --extra gpu: CuPy and the CUDA wheels) need.
  UV_OFFLINE=1 UV_CACHE_DIR="$RUN/uv-cache" UV_PYTHON_INSTALL_DIR="$RUN/python" UV_PROJECT_ENVIRONMENT="$RUN/venv" UV_LINK_MODE=copy \
    "$RUN/tools/uv" sync --project "$RUN/source" --frozen --no-dev --python 3.12 ${UV_EXTRAS} \
    || { mark "exit-install"; exit 1; }
fi
case "${UV_EXTRAS}" in
  # The CUDA libraries come from the gpu extra's nvidia-* wheels, which CuPy does not search: on the Batch image, which
  # has the driver and no toolkit, the first kernel it compiled failed with "CuPy failed to load libnvrtc.so.12".
  # A fit job that cannot reach its GPU would fit on the CPUs at the GPU VM's price until its timeout: it stops here,
  # and also if CuPy cannot compile and run a kernel.
  *gpu*) export LD_LIBRARY_PATH="$(ls -d "$RUN"/venv/lib/python3.12/site-packages/nvidia/*/lib | paste -sd:)${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
         "$RUN/venv/bin/python" -c "import cupy, sys; sys.exit(cupy.cuda.runtime.getDeviceCount() < 1 or float(cupy.eye(2).sum()) != 2.0)" \
           || { mark "exit-no-gpu"; exit 1; } ;;
esac
# The markers' times split a start into its parts: the VM's boot to "started", the environment to "env-ready", the
# run's restore to "restored".
mark env-ready
publisher=""
if [ -n "$runtime" ] && [ -z "$prebuilt" ] && ! ls "$runtime"/*/COMPLETE > /dev/null 2>&1; then
  "$RUN/venv/bin/python" "$RUN/source/launcher/workspace/runtime_pack.py" --root "$RUN" --into "$runtime/$(hostname)-$$" \
    > "$RUN/runtime-publish.log" 2>&1 &
  publisher=$!
fi
export WORKSPACE_CDR="${WORKSPACE_CDR}" GOOGLE_PROJECT="${GOOGLE_PROJECT}" TMPDIR="$RUN/tmp"
# google-auth 2.4x reaches the metadata server over mTLS when the VM offers its certificates, and the Batch image's
# do not verify ("CERTIFICATE_VERIFY_FAILED"): the job then had no credentials. Plain HTTP to the metadata server is
# the VM-local path every earlier version used.
export GCE_METADATA_MTLS_MODE=none
# numpy's OpenBLAS is built for 128 threads and keeps a buffer table of that size: each of its own workers holds one,
# and each thread calling it takes one more. The stage-0 host pool calls it from one thread per CPU. On 128 vCPUs the
# table overflowed ("precompiled NUM_THREADS exceeded, adding auxiliary array for thread metadata") with 127 workers
# and again with 63, and the fit died 20 s in (segfault, or "corrupted double-linked list"); on 64 vCPUs with 63 it
# ran. Its workers get the room the pool leaves, at most one per CPU: a fit VM above 64 vCPUs has almost none.
cpus=$(nproc)
room=$(( 128 - cpus ))
export OPENBLAS_NUM_THREADS=$(( room < 1 ? 1 : room < cpus ? room : cpus ))
# A driver that dies on a signal writes every thread's Python stack to the task log: the first AoU fits ended in
# "Segmentation fault" with no other line.
export PYTHONFAULTHANDLER=1
# Two minutes without a progress line, the driver logs where its main thread is (sv_pgs/progress.py), so the progress
# copy below shows what a silent stretch spends its time on: the AoU disease fits went twenty minutes between lines.
export SVPGS_QUIET_STACK_SECONDS=120
# The driver's log (below) also holds, once a minute from here to the driver's end, a line of the VM's resources from
# launcher/workspace/sample_resources.py (each GPU's utilization over nvidia-smi's samples every 5 s and its memory, the
# CPU's busy and iowait shares, the load, the host memory in use, the run disk's and the network's MiB/s), and the store
# restore's time: with the driver's timing lines (sv_pgs/phase_timer.py) the progress copies are a profile of the run,
# which benchmarks/profile_log.py reads. Every writer appends, so no line overwrites another; the sampler's output and
# exit are its own, never the task's, and it stops with the task whichever way the task ends.
: > "$RUN/driver.log"
"$RUN/venv/bin/python" "$RUN/source/launcher/workspace/sample_resources.py" --every 60 --gpu-every 5 --disk "$RUN" >> "$RUN/driver.log" 2>&1 &
sampler=$!
trap 'kill "$sampler" 2>/dev/null' EXIT
restore_started=$SECONDS
# The job's bucket mounts (the job templates' volumes): an input file there is keyed by its object's generation instead
# of a pass over its bytes (sv_pgs/content_identity.py), which for the imputed and GATK-SV call sets is terabytes a start.
# IMPUTED_BUCKET holds the imputed batches and their strata sidecar, PANEL_BUCKET the panel's bubble.split sites.
export SVPGS_GCS_MOUNTS='{"/mnt/disks/ops": "gs://${OPS_BUCKET}", "/mnt/disks/cdr": "gs://${CDR_BUCKET}", "/mnt/disks/imputed": "gs://${IMPUTED_BUCKET}", "/mnt/disks/panel": "gs://${PANEL_BUCKET}"}'
# The restore hashes each file's bytes as it writes them and keeps the digests here, on this job's own disk
# (sv_pgs/content_identity.py): the fit's digest of the store it restored then reads none of its 547 GB again.
export SVPGS_RESTORED_DIGESTS="$RUN/restored-digests"
# A score batch's read of the store (tens of minutes to over an hour for the whole genome) is kept this often, each
# time its partial sums (a trait's models and structural parts x 65 columns x its people x 8 bytes a device, ~0.1 GB
# est.) that the pusher sends on (sv_pgs/postfit_checkpoint.py): a preemption loses at most this and one push.
export SVPGS_SCORE_READ_CHECKPOINT_SECONDS=300
mkdir -p "$TMPDIR"
# Batch cannot write to an existing disk, so this job's disk is new and the run lives in the workspace bucket
# (sv_pgs/run_mirror.py): restored before the driver starts, pushed every minute while it runs (each push sends only
# what changed: the fit's new restart units, from Stage 0's LD store to each model's best EB start, and new steps), and
# pushed once more after it exits. A preemption loses at most the fit progress since the last push; a push sending a
# large unit (Stage 0's LD store, minutes) runs beside the fit, and the next waits for it. flock keeps one push at a
# time. A fit job given FIT_ARMS restores and pushes only those arms' restart units. With BASE_RUN ("${BASE_RUN}"),
# that run's mirror carries this run's completed steps before the fit where this run's mirror holds none of a step, and
# no push copies them here.
base=()
[ -z "${BASE_RUN}" ] || base=(--base "gs://${OPS_BUCKET}/svpgs/${BASE_RUN}/run")
mirror() {
  flock "$RUN/mirror.lock" "$RUN/venv/bin/sv-pgs" run-mirror "$1" --config "$OPS/run_config.json" --mirror "gs://${OPS_BUCKET}/svpgs/${RUN_ID}/run" \
    ${base[@]+"${base[@]}"} ${fit_arm[@]+"${fit_arm[@]}"}
}
mirror restore || { mark "exit-restore"; exit 1; }
mark restored
# A loop's sleep goes first: killed alone, the subshell left it running, and the task (and its log) ended only when the
# sleep did. A push in progress is left to finish; the last push below waits on its lock.
stop() { pkill -x -P "$1" sleep 2>/dev/null; kill "$1" 2>/dev/null; }
( while sleep 60; do mirror push || mark "push-failed"; done ) &
pusher=$!
# Batch writes the task log to the bucket only when the task ends, so a fit gave no sign of its progress for hours. The
# driver's stderr also goes to a file whose last lines are copied beside the task log every 5 minutes: the same lines
# the task log holds (steps, counts, timings, paths).
# The whole log goes beside them (progress-task<i>.full.log): the run's timeline from the restore on, whose time leads it
# (only definitions ran between the restore's start and here).
echo "[$(date '+%Y-%m-%d %H:%M:%S')] timing: store_restore $((SECONDS - restore_started)) s" >> "$RUN/driver.log"
progress="$(dirname "$0")/progress-task${BATCH_TASK_INDEX}.log"
copy_progress() { tail -n 300 "$RUN/driver.log" > "$progress" 2>/dev/null; cp "$RUN/driver.log" "${progress%.log}.full.log" 2>/dev/null; }
"$RUN/venv/bin/sv-pgs" workspace-run --config "$OPS/run_config.json" --through "${THROUGH}" ${shard[@]+"${shard[@]}"} ${fit_arm[@]+"${fit_arm[@]}"} \
  2> >(tee -a "$RUN/driver.log" >&2) &
driver=$!
( while sleep 300; do copy_progress; done ) &
progressor=$!
wait "$driver"
status=$?
kill "$sampler" 2>/dev/null
stop "$progressor"
copy_progress
# AFTER_SCRIPT ("${AFTER_SCRIPT}"), a script of the source tree, runs once the driver has finished, with RUN and OPS set,
# its output beside the progress log: benchmarks/bench_real/aou_ldpred2.sh reads the steps the driver left.
# An arm-only driver exits successfully with fit.partial (StepPart). Its success is not a completed run: the
# comparison script must wait for the resubmission that holds both arms and reaches the requested final step, in every
# region's directory when the run fits regions (workspace_pipeline.completed_through).
completed() {
  "$RUN/venv/bin/python" -c 'import sys; from sv_pgs.workspace_pipeline import WorkspaceConfig, completed_through; sys.exit(0 if completed_through(WorkspaceConfig.read(sys.argv[1]), sys.argv[2]) else 1)' "$OPS/run_config.json" "${THROUGH}"
}
if [ "$status" -eq 0 ] && [ -n "${AFTER_SCRIPT}" ] && ! completed; then
  mark "after-deferred"
elif [ "$status" -eq 0 ] && [ -n "${AFTER_SCRIPT}" ]; then
  mark "after-started"
  RUN="$RUN" OPS="$OPS" bash "$RUN/source/${AFTER_SCRIPT}" > "$(dirname "$0")/after-task${BATCH_TASK_INDEX}.log" 2>&1 \
    && mark "after-done" || { mark "exit-after"; status=1; }
fi
stop "$pusher"
# A run whose last push failed did not keep its results: the job fails even if the driver finished.
mirror push || { mark "exit-push"; [ "$status" -ne 0 ] || status=1; }
# A publication still writing is let finish: one cut short leaves no COMPLETE, so no job reads it, but its parts stay.
[ -z "$publisher" ] || wait "$publisher"
mark "exit-${status}"
exit "$status"
