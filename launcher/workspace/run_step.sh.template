#!/bin/bash
# TEMPLATE, never launched by an agent: launching is the user's decision (submit.sh fills and submits it).
# The Batch task. It builds the locked environment offline with uv from what the user staged under
# svpgs/${RUN_ID}/ in the ops bucket (README.md, "Staging": the source tree, the uv binary, a uv cache holding every
# locked wheel, and a uv-installed CPython 3.12), then runs the pipeline through ${THROUGH}. The VM has no external IP,
# and the image's own Python is not the 3.12 sv-pgs needs, so nothing is fetched and the image's Python is never used.
# Status goes only to empty marker files in the workspace's ops bucket mount.
set -uo pipefail
OPS=/mnt/disks/ops/svpgs/${RUN_ID}
RUN=/mnt/disks/run
mark() { mkdir -p "$OPS/markers" && : > "$OPS/markers/$(date -u +%Y%m%dT%H%M%SZ)_task_$1"; }
trap 'mark "terminated"; exit 75' TERM
mark started
if [ ! -f "$RUN/tools/staged" ]; then
  # The bucket mount gives no file an execute bit, so uv and Python are copied to the run disk first. The marker is
  # written last, so a copy a preemption cut short is redone.
  mkdir -p "$RUN/tools" && cp "$OPS/bin/uv" "$RUN/tools/uv" && chmod +x "$RUN/tools/uv" \
    && rm -rf "$RUN/python" "$RUN/uv-cache" && cp -r "$OPS/python" "$RUN/python" && cp -r "$OPS/uv-cache" "$RUN/uv-cache" \
    && chmod +x "$RUN"/python/*/bin/* && : > "$RUN/tools/staged" \
    || { mark "exit-install"; exit 1; }
fi
# Every start syncs: a retried task can find the venv a preempted attempt left half built, and the sync adds only what
# this job's extras (the GPU job's --extra gpu: CuPy and the CUDA wheels) need.
UV_OFFLINE=1 UV_CACHE_DIR="$RUN/uv-cache" UV_PYTHON_INSTALL_DIR="$RUN/python" UV_PROJECT_ENVIRONMENT="$RUN/venv" UV_LINK_MODE=copy \
  "$RUN/tools/uv" sync --project "$OPS/source" --frozen --no-dev --python 3.12 ${UV_EXTRAS} \
  || { mark "exit-install"; exit 1; }
case "${UV_EXTRAS}" in
  # A fit job that cannot reach its GPU would fit on the CPUs at the GPU VM's price until its timeout: it stops here.
  *gpu*) "$RUN/venv/bin/python" -c "import cupy, sys; sys.exit(cupy.cuda.runtime.getDeviceCount() < 1)" \
           || { mark "exit-no-gpu"; exit 1; } ;;
esac
export WORKSPACE_CDR="${WORKSPACE_CDR}" GOOGLE_PROJECT="${GOOGLE_PROJECT}" TMPDIR="$RUN/tmp"
# The job's bucket mounts (the job templates' volumes): an input file there is keyed by its object's generation instead
# of a pass over its bytes (sv_pgs/content_identity.py), which for the imputed and GATK-SV call sets is terabytes a start.
export SVPGS_GCS_MOUNTS='{"/mnt/disks/ops": "gs://${OPS_BUCKET}", "/mnt/disks/cdr": "gs://${CDR_BUCKET}"}'
mkdir -p "$TMPDIR"
# Batch cannot write to an existing disk, so this job's disk is new and the run lives in the workspace bucket
# (sv_pgs/run_mirror.py): restored before the driver starts, pushed every 15 minutes while it runs (each push sends
# only new checkpoints and finished steps), and pushed once more after it exits. A preemption loses at most the fit
# progress since the last push. flock keeps one push at a time.
mirror() {
  flock "$RUN/mirror.lock" "$RUN/venv/bin/sv-pgs" run-mirror "$1" --config "$OPS/run_config.json" --mirror "gs://${OPS_BUCKET}/svpgs/${RUN_ID}/run"
}
mirror restore || { mark "exit-restore"; exit 1; }
( while sleep 900; do mirror push || mark "push-failed"; done ) &
pusher=$!
"$RUN/venv/bin/sv-pgs" workspace-run --config "$OPS/run_config.json" --through "${THROUGH}" &
wait $!
status=$?
kill "$pusher"
# A run whose last push failed did not keep its results: the job fails even if the driver finished.
mirror push || { mark "exit-push"; [ "$status" -ne 0 ] || status=1; }
mark "exit-${status}"
exit "$status"
